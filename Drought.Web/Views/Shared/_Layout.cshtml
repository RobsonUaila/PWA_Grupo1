<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Grupo 1 | AI Soil Moisture Drought System</title>
    
    <!-- Google Fonts: Syne & DM Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&family=Syne:wght@500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <!-- Project Stylesheet with Version Cache Busting -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-wrapper">
        <!-- Sidebar Navigation -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <i data-lucide="sprout" class="logo-icon"></i>
                <div>
                    <h1 style="letter-spacing: -0.03em;">AI4Drought</h1>
                    <p>Chókwè & Massinga · Grupo 1</p>
                </div>
            </div>

            <nav class="sidebar-nav">
                <a asp-controller="Home" asp-action="Index">
                    <i data-lucide="home"></i> <span>Início</span>
                </a>
                <a asp-controller="Dashboard" asp-action="Index">
                    <i data-lucide="layout-dashboard"></i> <span>Dashboard & Mapa</span>
                </a>
                <a asp-controller="Admin" asp-action="Import">
                    <i data-lucide="database"></i> <span>Administração</span>
                </a>
                <a href="/swagger" target="_blank" rel="noopener">
                    <i data-lucide="terminal"></i> <span>API REST (Swagger)</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <div style="margin-bottom: 8px; font-weight: 700; color: var(--secondary);">USTM — PWA .NET</div>
                <div>Projecto 1 · Grupo 1 &copy; @DateTime.UtcNow.Year</div>
            </div>
        </aside>
        
        <!-- Main Content Area -->
        <div class="main-content">
            <header class="topbar">
                <div>
                    <h2 class="page-title">@ViewData["Title"]</h2>
                </div>

                <!-- User Session Widget -->
                <div class="user-session" style="margin-left: auto; display: flex; align-items: center; gap: 16px;">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div style="display: flex; align-items: center; gap: 10px; background: white; padding: 6px 14px; border-radius: 30px; border: 1px solid var(--border); box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
                            <i data-lucide="user-check" style="width: 18px; height: 18px; color: var(--accent);"></i>
                            <span style="font-size: 0.9rem; font-weight: 600;">@User.Identity.Name</span>
                            @if (User.IsInRole("Administrador"))
                            {
                                <span class="badge" style="background: var(--primary); font-size: 0.7rem; padding: 3px 8px;">Admin</span>
                            }
                            else
                            {
                                <span class="badge" style="background: var(--accent); font-size: 0.7rem; padding: 3px 8px;">Investigador</span>
                            }
                        </div>
                        <form asp-controller="Account" asp-action="Logout" method="post" style="display: inline; margin: 0;">
                            <button type="submit" class="btn" style="padding: 8px 16px; font-size: 0.85rem; background: #6c757d; border-radius: 20px;">
                                <i data-lucide="log-out" style="width: 15px; height: 15px;"></i> Sair
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn" style="padding: 9px 18px; font-size: 0.9rem; border-radius: 20px;">
                            <i data-lucide="log-in" style="width: 16px; height: 16px;"></i> Iniciar Sessão
                        </a>
                    }
                </div>
            </header>
            
            <main class="container">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        // Highlighting do link ativo
        const currentPath = window.location.pathname.toLowerCase();
        document.querySelectorAll('.sidebar-nav a').forEach(link => {
            const href = link.getAttribute('href')?.toLowerCase();
            if (href && (currentPath === href || (href !== '/' && currentPath.startsWith(href)))) {
                link.classList.add('active');
            }
        });
        lucide.createIcons();
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
