@model Drought.Web.Models.RegisterViewModel
@{
    ViewData["Title"] = "Registar Conta";
}

<div style="max-width: 540px; margin: 40px auto;">
    <div class="card" style="padding: 40px;">
        <div style="text-align: center; margin-bottom: 25px;">
            <i data-lucide="user-plus" style="width: 48px; height: 48px; color: var(--accent);"></i>
            <h2 style="margin: 12px 0 6px;">Criar Conta de Investigador</h2>
            <p style="opacity: 0.8; font-size: 0.95rem; margin: 0;">Acesso à plataforma académica de seca</p>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div style="background: rgba(164, 56, 32, 0.1); border-left: 4px solid var(--status-extreme); padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; color: var(--status-extreme); font-weight: 500;">
                @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                {
                    <p style="margin: 0;">@error.ErrorMessage</p>
                }
            </div>
        }

        <form asp-action="Register" method="post">
            <div style="margin-bottom: 16px;">
                <label asp-for="FullName" style="display: block; font-weight: 600; margin-bottom: 6px;"></label>
                <input asp-for="FullName" class="form-control" style="width: 100%; box-sizing: border-box;" placeholder="Nome e Apelido" required />
                <span asp-validation-for="FullName" style="color: var(--status-extreme); font-size: 0.85rem;"></span>
            </div>

            <div style="margin-bottom: 16px;">
                <label asp-for="Email" style="display: block; font-weight: 600; margin-bottom: 6px;"></label>
                <input asp-for="Email" class="form-control" style="width: 100%; box-sizing: border-box;" placeholder="investigador@instituto.mz" required />
                <span asp-validation-for="Email" style="color: var(--status-extreme); font-size: 0.85rem;"></span>
            </div>

            <div style="margin-bottom: 16px;">
                <label asp-for="Organization" style="display: block; font-weight: 600; margin-bottom: 6px;"></label>
                <input asp-for="Organization" class="form-control" style="width: 100%; box-sizing: border-box;" placeholder="Universidade / INAM / USTM" />
            </div>

            <div style="margin-bottom: 16px;">
                <label asp-for="Password" style="display: block; font-weight: 600; margin-bottom: 6px;"></label>
                <input asp-for="Password" type="password" class="form-control" style="width: 100%; box-sizing: border-box;" placeholder="Mínimo 8 caracteres" required />
                <span asp-validation-for="Password" style="color: var(--status-extreme); font-size: 0.85rem;"></span>
            </div>

            <div style="margin-bottom: 24px;">
                <label asp-for="ConfirmPassword" style="display: block; font-weight: 600; margin-bottom: 6px;"></label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" style="width: 100%; box-sizing: border-box;" placeholder="Confirme a palavra-passe" required />
                <span asp-validation-for="ConfirmPassword" style="color: var(--status-extreme); font-size: 0.85rem;"></span>
            </div>

            <button type="submit" class="btn" style="width: 100%; padding: 14px; font-size: 1.05rem;">
                <i data-lucide="check"></i> Concluir Registo
            </button>
        </form>

        <div style="text-align: center; margin-top: 24px; font-size: 0.95rem;">
            Já possui uma conta? <a asp-action="Login" style="color: var(--primary); font-weight: 600; text-decoration: none;">Iniciar Sessão</a>
        </div>
    </div>
</div>
