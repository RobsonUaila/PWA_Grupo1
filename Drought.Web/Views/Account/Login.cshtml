@model Drought.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sessão";
}

<div style="max-width: 520px; margin: 40px auto;">
    <div class="card" style="padding: 40px;">
        <div style="text-align: center; margin-bottom: 30px;">
            <i data-lucide="shield-check" style="width: 48px; height: 48px; color: var(--primary);"></i>
            <h2 style="margin: 12px 0 6px;">Autenticação no Sistema</h2>
            <p style="opacity: 0.8; font-size: 0.95rem; margin: 0;">Plataforma de Classificação de Seca · Grupo 1</p>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div style="background: rgba(164, 56, 32, 0.1); border-left: 4px solid var(--status-extreme); padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; color: var(--status-extreme); font-weight: 500;">
                @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                {
                    <p style="margin: 0;">@error.ErrorMessage</p>
                }
            </div>
        }

        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" id="loginForm">
            <div style="margin-bottom: 20px;">
                <label asp-for="Email" style="display: block; font-weight: 600; margin-bottom: 8px;"></label>
                <input asp-for="Email" id="emailInput" class="form-control" style="width: 100%; box-sizing: border-box;" placeholder="utilizador@drought.mz" required />
                <span asp-validation-for="Email" style="color: var(--status-extreme); font-size: 0.85rem;"></span>
            </div>

            <div style="margin-bottom: 24px;">
                <label asp-for="Password" style="display: block; font-weight: 600; margin-bottom: 8px;">Palavra-passe</label>
                <input asp-for="Password" id="passwordInput" type="password" class="form-control" style="width: 100%; box-sizing: border-box;" placeholder="••••••••" required />
                <span asp-validation-for="Password" style="color: var(--status-extreme); font-size: 0.85rem;"></span>
            </div>

            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px;">
                <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 0.95rem;">
                    <input asp-for="RememberMe" type="checkbox" style="width: 18px; height: 18px;" />
                    Lembrar-me neste dispositivo
                </label>
            </div>

            <button type="submit" class="btn" style="width: 100%; padding: 14px; font-size: 1.05rem;">
                <i data-lucide="log-in"></i> Entrar no Sistema
            </button>
        </form>

        <!-- Quick Demo Credentials Box -->
        <div style="margin-top: 32px; padding: 18px; background: rgba(229, 168, 115, 0.12); border-radius: var(--radius-soft); border: 1px dashed var(--secondary);">
            <div style="font-weight: 700; color: var(--primary); font-size: 0.9rem; margin-bottom: 10px; display: flex; align-items: center; gap: 8px;">
                <i data-lucide="key" style="width: 16px; height: 16px;"></i> Contas de Demonstração (Clique para Preencher):
            </div>
            <div style="display: flex; flex-direction: column; gap: 8px;">
                <button type="button" onclick="fillCredentials('admin@drought.mz', 'Admin123!')" style="background: white; border: 1px solid var(--border); padding: 8px 12px; font-size: 0.85rem; color: var(--text-main); text-align: left; border-radius: 6px; cursor: pointer; display: flex; justify-content: space-between; align-items: center;">
                    <span><strong>Administrador:</strong> admin@drought.mz</span>
                    <span class="badge" style="background: var(--primary); font-size: 0.7rem; padding: 2px 6px;">Admin</span>
                </button>
                <button type="button" onclick="fillCredentials('investigador@drought.mz', 'Invest123!')" style="background: white; border: 1px solid var(--border); padding: 8px 12px; font-size: 0.85rem; color: var(--text-main); text-align: left; border-radius: 6px; cursor: pointer; display: flex; justify-content: space-between; align-items: center;">
                    <span><strong>Investigador:</strong> investigador@drought.mz</span>
                    <span class="badge" style="background: var(--accent); font-size: 0.7rem; padding: 2px 6px;">Investigador</span>
                </button>
            </div>
        </div>

        <div style="text-align: center; margin-top: 24px; font-size: 0.95rem;">
            Ainda não tem conta? <a asp-action="Register" style="color: var(--primary); font-weight: 600; text-decoration: none;">Criar conta de Investigador</a>
        </div>
    </div>
</div>

<script>
    function fillCredentials(email, password) {
        document.getElementById('emailInput').value = email;
        document.getElementById('passwordInput').value = password;
    }
</script>
